<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <!-- Windows 10 2004 (build 19041) and newer: the virtual camera API is Windows 11 only,
         Windows 10 gets the DirectShow filter (docs/windows10.md). The engine imports
         DnsServiceBrowse/Resolve (mDNS), which need build 18362; 19041 is the supported floor. -->
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>CamStudio</RootNamespace>
    <AssemblyName>CamStudio</AssemblyName>
    <Version>0.1.5</Version>
    <Product>Cam Studio</Product>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged app that carries the Windows App SDK runtime with it,
         so nothing has to be installed separately. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\CamStudio.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <!-- Program.cs provides Main (single-instance redirection). -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- Native camera engine built by CMake (scripts\build.ps1). -->
    <None Include="..\build\Release\CamStudioEngine.dll" Link="CamStudioEngine.dll"
          CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\build\Release\CamStudioEngine.dll')" />
  </ItemGroup>

</Project>
