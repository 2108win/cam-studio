<Application
    x:Class="CamStudio.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Windows 11 Settings-style card. -->
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="MinHeight" Value="64" />
            </Style>

            <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="2,20,0,8" />
            </Style>

            <Style x:Key="CardIconStyle" TargetType="FontIcon">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="Margin" Value="2,0,16,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="CardDescriptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="InfoLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="Margin" Value="0,0,16,6" />
            </Style>

            <Style x:Key="InfoValueStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="Margin" Value="0,0,0,6" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="IsTextSelectionEnabled" Value="True" />
            </Style>

            <!-- Icon buttons of the bottom toolbar. Toggles fill with the accent
                 colour when on, so active features are visible at a glance. -->
            <Style x:Key="ToolButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
                <Setter Property="Width" Value="44" />
                <Setter Property="Height" Value="40" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>
            <Style x:Key="ToolToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
                <Setter Property="Width" Value="44" />
                <Setter Property="Height" Value="40" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
            <Style x:Key="ToolIconStyle" TargetType="FontIcon">
                <Setter Property="FontSize" Value="17" />
            </Style>
            <!-- Small dot on a tool button whose setting is not the default. -->
            <Style x:Key="ToolDotStyle" TargetType="Ellipse">
                <Setter Property="Width" Value="6" />
                <Setter Property="Height" Value="6" />
                <Setter Property="Fill" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="Margin" Value="0,7,8,0" />
                <Setter Property="IsHitTestVisible" Value="False" />
            </Style>
            <Style x:Key="FlyoutTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="0,0,0,12" />
            </Style>

            <!-- Controls drawn over the video (camera-app style). -->
            <Style x:Key="LensChipStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
                <Setter Property="MinWidth" Value="44" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="CornerRadius" Value="17" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="#33FFFFFF" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="OverlayRoundButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Width" Value="42" />
                <Setter Property="Height" Value="42" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="21" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="#B3202020" />
            </Style>
            <Style x:Key="OverlayRoundToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
                <Setter Property="Width" Value="42" />
                <Setter Property="Height" Value="42" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="21" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="#B3202020" />
            </Style>

            <!-- Translucent pill used over the video. -->
            <Style x:Key="OverlayPillStyle" TargetType="Border">
                <Setter Property="Background" Value="#B3202020" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="12,5" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
