<Application
    x:Class="CamStudio.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Our icons (Fluent UI System Icons, in Assets/Fonts: Windows 10 has no Segoe
                     Fluent Icons). WinUI's own controls keep their system glyphs. -->
                <ResourceDictionary Source="Icons.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- The accent is Windows' own unless Settings › Màu nhấn picks one of ours
                 (Services/AccentColors.cs sets the SystemAccentColor ramp WinUI's controls use;
                 brushes overridden here would reach only our own XAML). The source tiles are a
                 light wash of it. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="SourceTileBrush" Color="{ThemeResource SystemAccentColorLight2}" Opacity="0.14" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="SourceTileBrush" Color="{ThemeResource SystemAccentColorDark1}" Opacity="0.10" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Design rules (2026-10-20), one set for the whole app:
                 - spacing in steps of 4 (4, 8, 12, 16, 20, 24);
                 - three corner radii: controls 6, cards 10, the preview and panes 12; a pill is
                   half its height;
                 - text only in WinUI's ramp: Caption 12, Body 14, Subtitle 20;
                 - an icon is as big as the text beside it (12, 14), 16 on its own, 48 in an
                   empty state. -->
            <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
            <CornerRadius x:Key="OverlayCornerRadius">10</CornerRadius>
            <CornerRadius x:Key="CardCornerRadius">10</CornerRadius>
            <CornerRadius x:Key="PanelCornerRadius">12</CornerRadius>

            <!-- Colour slider tracks: what each slider does, drawn on the slider itself. -->
            <LinearGradientBrush x:Key="BrightnessTrackBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#FF151515" Offset="0" />
                <GradientStop Color="#FFF4F4F4" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="ContrastTrackBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#FF9C9C9C" Offset="0" />
                <GradientStop Color="#FF8A8A8A" Offset="0.45" />
                <GradientStop Color="#FF050505" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="SaturationTrackBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#FF8C8C8C" Offset="0" />
                <GradientStop Color="#FFB98A9F" Offset="0.5" />
                <GradientStop Color="#FFFF3F7A" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="TemperatureTrackBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#FF3E8BFF" Offset="0" />
                <GradientStop Color="#FFE6E6E6" Offset="0.5" />
                <GradientStop Color="#FFFF9330" Offset="1" />
            </LinearGradientBrush>

            <SolidColorBrush x:Key="LiveBrush" Color="#FFE5484D" />

            <!-- Theme colours for rows built in code: a brush looked up in code follows the Windows
                 theme, not the app's own (Settings › Giao diện); a style's ThemeResource follows it. -->
            <Style x:Key="SourceSubtitleStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="MaxLines" Value="1" />
            </Style>
            <!-- "Chưa kết nối": the sources that cannot be used now, under the ones that can. -->
            <Style x:Key="ListSectionLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="4,12,0,0" />
            </Style>
            <!-- A source card (left pane, 2026-10-19 look): one card per device, icon tile, name, state. -->
            <Style x:Key="SourceCardStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="12" />
                <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
            <Style x:Key="SourceCardSelectedStyle" TargetType="Button" BasedOn="{StaticResource SourceCardStyle}">
                <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="IconTileStyle" TargetType="Border">
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Background" Value="{ThemeResource SourceTileBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="IconTileSelectedStyle" TargetType="Border" BasedOn="{StaticResource IconTileStyle}">
                <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
            </Style>
            <Style x:Key="TileGlyphStyle" TargetType="FontIcon">
                <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            </Style>
            <Style x:Key="TileGlyphSelectedStyle" TargetType="FontIcon" BasedOn="{StaticResource TileGlyphStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
            </Style>
            <!-- "USB" / "Wi‑Fi" on a phone reachable both ways. -->
            <Style x:Key="RouteChipStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
                <Setter Property="Height" Value="24" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="FontSize" Value="12" />
            </Style>
            <Style x:Key="CardLinkStyle" TargetType="HyperlinkButton">
                <Setter Property="Padding" Value="4,0" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <!-- (i) next to a heading: the explanation, on hover and on click (touch). -->
            <Style x:Key="InfoButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
                <Setter Property="Width" Value="24" />
                <Setter Property="Height" Value="24" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="InfoTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="MaxWidth" Value="280" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <!-- A colour preset: a swatch and a name. -->
            <Style x:Key="PresetChipStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="Padding" Value="0,8" />
                <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
                <Setter Property="MinWidth" Value="0" />
            </Style>
            <Style x:Key="SwatchStyle" TargetType="Ellipse">
                <Setter Property="Width" Value="24" />
                <Setter Property="Height" Value="24" />
                <Setter Property="Stroke" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="StrokeThickness" Value="1" />
            </Style>
            <Style x:Key="PresetLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,4,0,0" />
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
            <Style x:Key="SliderValueStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <!-- The camera bar under the preview: lenses, front / back, flash, exposure. -->
            <Style x:Key="CameraBarStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="21" />
                <Setter Property="Padding" Value="4" />
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>
            <Style x:Key="BarIconButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
                <Setter Property="MinWidth" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="8,0" />
                <Setter Property="CornerRadius" Value="16" />
            </Style>
            <Style x:Key="BarIconToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
                <Setter Property="MinWidth" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="8,0" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="Transparent" />
            </Style>
            <Style x:Key="BarDividerStyle" TargetType="Border">
                <Setter Property="Width" Value="1" />
                <Setter Property="Height" Value="20" />
                <Setter Property="Margin" Value="4,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            </Style>
            <!-- Inspector sections (right pane): one Expander each, no tabs. -->
            <Style x:Key="SectionExpanderStyle" TargetType="Expander">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
            <Style x:Key="SectionIconStyle" TargetType="FontIcon">
                <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Margin" Value="0,0,12,0" />
                <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            </Style>
            <Style x:Key="SectionSummaryStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="8,0,8,0" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
            <Style x:Key="InspectorSubheadStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,16,0,8" />
            </Style>
            <Style x:Key="InspectorHintStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,4,0,0" />
            </Style>
            <Style x:Key="SegmentToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="8,0" />
            </Style>
            <Style x:Key="SegmentButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="8,0" />
            </Style>

            <!-- Windows 11 Settings-style card. -->
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="MinHeight" Value="64" />
            </Style>

            <Style x:Key="InfoLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="Margin" Value="0,0,16,8" />
            </Style>

            <Style x:Key="InfoValueStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="Margin" Value="0,0,0,8" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="IsTextSelectionEnabled" Value="True" />
            </Style>

            <!-- Icon buttons of the left pane's bottom bar. -->
            <Style x:Key="ToolButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="40" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
            </Style>
            <Style x:Key="ToolIconStyle" TargetType="FontIcon">
                <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
                <Setter Property="FontSize" Value="16" />
            </Style>

            <!-- Shows / hides a pane: an accent icon when on, no accent fill (that reads as "a
                 feature is on" and outweighs the virtual camera switch beside it). -->
            <Style x:Key="PaneToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="40" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="Transparent" />
            </Style>

            <!-- A phone lens (0.6×, 1×, Macro…) in the inspector's focal-length row. -->
            <Style x:Key="LensChipStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
                <Setter Property="MinWidth" Value="48" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <!-- Translucent pill used over the video. -->
            <Style x:Key="OverlayPillStyle" TargetType="Border">
                <Setter Property="Background" Value="#B3202020" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="12,6" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
