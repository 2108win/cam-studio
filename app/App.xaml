<Application
    x:Class="CamStudio.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <!-- WinUI's controls take their accent from the SystemAccentColor ramp below (dark theme:
                 Light2, light theme: Dark1); brushes overridden here would reach only our own XAML. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="SourceTileBrush" Color="#1F4A8CFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="SourceTileBrush" Color="#161F5FD6" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Cam Studio's own accent, whatever the Windows accent is (a red Windows accent made
                 selected chips look like errors). One royal blue in both themes; red stays for
                 "live", green / amber for the connection dots. -->
            <Color x:Key="SystemAccentColor">#FF2F6FEB</Color>
            <Color x:Key="SystemAccentColorLight1">#FF3D7FF5</Color>
            <Color x:Key="SystemAccentColorLight2">#FF4A8CFF</Color>
            <Color x:Key="SystemAccentColorLight3">#FF8DB6FF</Color>
            <Color x:Key="SystemAccentColorDark1">#FF1F5FD6</Color>
            <Color x:Key="SystemAccentColorDark2">#FF1A4FB0</Color>
            <Color x:Key="SystemAccentColorDark3">#FF123E8F</Color>

            <!-- Colour slider tracks: what each slider does, drawn on the slider itself. -->
            <LinearGradientBrush x:Key="BrightnessTrackBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#FF151515" Offset="0" />
                <GradientStop Color="#FFF4F4F4" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="ContrastTrackBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#FF9C9C9C" Offset="0" />
                <GradientStop Color="#FF8A8A8A" Offset="0.45" />
                <GradientStop Color="#FF050505" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="SaturationTrackBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#FF8C8C8C" Offset="0" />
                <GradientStop Color="#FFB98A9F" Offset="0.5" />
                <GradientStop Color="#FFFF3F7A" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="TemperatureTrackBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#FF3E8BFF" Offset="0" />
                <GradientStop Color="#FFE6E6E6" Offset="0.5" />
                <GradientStop Color="#FFFF9330" Offset="1" />
            </LinearGradientBrush>

            <SolidColorBrush x:Key="LiveBrush" Color="#FFE5484D" />

            <!-- One row of the source list (left pane), Windows Settings navigation style. -->
            <Style x:Key="SourceItemStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="10,7,10,7" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="MinHeight" Value="48" />
            </Style>
            <!-- Theme colours for rows built in code: a brush looked up in code follows the Windows
                 theme, not the app's own (Settings › Giao diện); a style's ThemeResource follows it. -->
            <Style x:Key="SourceItemSelectedStyle" TargetType="Button" BasedOn="{StaticResource SourceItemStyle}">
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="SourceSubtitleStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="MaxLines" Value="1" />
            </Style>
            <Style x:Key="SourceIconSelectedStyle" TargetType="FontIcon">
                <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            </Style>
            <Style x:Key="SelectionPillStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                <Setter Property="Width" Value="3" />
                <Setter Property="Height" Value="18" />
                <Setter Property="CornerRadius" Value="1.5" />
            </Style>
            <!-- A source card (left pane, 2026-10-19 look): one card per device, icon tile, name, state. -->
            <Style x:Key="SourceCardStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="12,10,12,10" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
            <Style x:Key="SourceCardSelectedStyle" TargetType="Button" BasedOn="{StaticResource SourceCardStyle}">
                <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="IconTileStyle" TargetType="Border">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Background" Value="{ThemeResource SourceTileBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="IconTileSelectedStyle" TargetType="Border" BasedOn="{StaticResource IconTileStyle}">
                <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
            </Style>
            <Style x:Key="TileGlyphStyle" TargetType="FontIcon">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            </Style>
            <Style x:Key="TileGlyphSelectedStyle" TargetType="FontIcon" BasedOn="{StaticResource TileGlyphStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
            </Style>
            <!-- "USB" / "Wi‑Fi" on a phone reachable both ways. -->
            <Style x:Key="RouteChipStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
                <Setter Property="Height" Value="24" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="FontSize" Value="11" />
            </Style>
            <Style x:Key="CardLinkStyle" TargetType="HyperlinkButton">
                <Setter Property="Padding" Value="4,0" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <!-- (i) next to a heading: the explanation, on hover and on click (touch). -->
            <Style x:Key="InfoButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
                <Setter Property="Width" Value="24" />
                <Setter Property="Height" Value="24" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="InfoTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="MaxWidth" Value="280" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <!-- A colour preset: a swatch and a name. -->
            <Style x:Key="PresetChipStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="Padding" Value="2,8,2,6" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="MinWidth" Value="0" />
            </Style>
            <Style x:Key="SwatchStyle" TargetType="Ellipse">
                <Setter Property="Width" Value="24" />
                <Setter Property="Height" Value="24" />
                <Setter Property="Stroke" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="StrokeThickness" Value="1" />
            </Style>
            <Style x:Key="PresetLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,5,0,0" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
            <Style x:Key="SliderValueStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <!-- The camera bar under the preview: lenses, front / back, flash, exposure. -->
            <Style x:Key="CameraBarStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="22" />
                <Setter Property="Padding" Value="6" />
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>
            <Style x:Key="BarIconButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
                <Setter Property="MinWidth" Value="36" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="9,0" />
                <Setter Property="CornerRadius" Value="16" />
            </Style>
            <Style x:Key="BarIconToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
                <Setter Property="MinWidth" Value="36" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="9,0" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="Transparent" />
            </Style>
            <Style x:Key="BarDividerStyle" TargetType="Border">
                <Setter Property="Width" Value="1" />
                <Setter Property="Height" Value="20" />
                <Setter Property="Margin" Value="6,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            </Style>
            <!-- Inspector sections (right pane): one Expander each, no tabs. -->
            <Style x:Key="SectionExpanderStyle" TargetType="Expander">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
            <Style x:Key="SectionIconStyle" TargetType="FontIcon">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="Margin" Value="0,0,10,0" />
                <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            </Style>
            <Style x:Key="SectionSummaryStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="8,0,8,0" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
            <Style x:Key="InspectorSubheadStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,12,0,6" />
            </Style>
            <Style x:Key="PaneLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="12,14,0,4" />
            </Style>
            <!-- Inspector (right pane) sections. -->
            <Style x:Key="InspectorHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="0,18,0,8" />
            </Style>
            <Style x:Key="InspectorHintStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,6,0,0" />
            </Style>
            <Style x:Key="SegmentToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="8,0" />
            </Style>
            <Style x:Key="SegmentButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="8,0" />
            </Style>

            <!-- Windows 11 Settings-style card. -->
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="MinHeight" Value="64" />
            </Style>

            <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="2,20,0,8" />
            </Style>

            <Style x:Key="CardIconStyle" TargetType="FontIcon">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="Margin" Value="2,0,16,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="CardDescriptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="InfoLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="Margin" Value="0,0,16,6" />
            </Style>

            <Style x:Key="InfoValueStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="Margin" Value="0,0,0,6" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="IsTextSelectionEnabled" Value="True" />
            </Style>

            <!-- Icon buttons of the bottom toolbar. Toggles fill with the accent
                 colour when on, so active features are visible at a glance. -->
            <Style x:Key="ToolButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
                <Setter Property="Width" Value="44" />
                <Setter Property="Height" Value="40" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>
            <Style x:Key="ToolToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
                <Setter Property="Width" Value="44" />
                <Setter Property="Height" Value="40" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
            <Style x:Key="ToolIconStyle" TargetType="FontIcon">
                <Setter Property="FontSize" Value="17" />
            </Style>
            <!-- Small dot on a tool button whose setting is not the default. -->
            <Style x:Key="ToolDotStyle" TargetType="Ellipse">
                <Setter Property="Width" Value="6" />
                <Setter Property="Height" Value="6" />
                <Setter Property="Fill" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="Margin" Value="0,7,8,0" />
                <Setter Property="IsHitTestVisible" Value="False" />
            </Style>
            <Style x:Key="FlyoutTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="0,0,0,12" />
            </Style>

            <!-- A phone lens (0.6×, 1×, Macro…) in the inspector's focal-length row. -->
            <Style x:Key="LensChipStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
                <Setter Property="MinWidth" Value="48" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <!-- Controls drawn over the video (camera-app style). -->
            <Style x:Key="OverlayRoundButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Width" Value="42" />
                <Setter Property="Height" Value="42" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="21" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="#B3202020" />
            </Style>
            <Style x:Key="OverlayRoundToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
                <Setter Property="Width" Value="42" />
                <Setter Property="Height" Value="42" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="21" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="#B3202020" />
            </Style>

            <!-- Translucent pill used over the video. -->
            <Style x:Key="OverlayPillStyle" TargetType="Border">
                <Setter Property="Background" Value="#B3202020" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="12,5" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
