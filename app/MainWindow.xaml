<Window
    x:Class="CamStudio.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Cam Studio">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <!-- Three panes, like Windows Settings: sources on Mica (left), then a content layer with the
         picture and the inspector (right: picture, camera incl. focal length, details). -->
    <Grid x:Name="RootGrid" SizeChanged="RootGrid_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />  <!-- title bar -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SourcesColumn" Width="284" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============ Title bar ============ -->
        <Grid x:Name="AppTitleBar" Grid.ColumnSpan="2" Padding="16,0,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
                <Image Source="Assets/CamStudio.png" Width="18" Height="18" />
                <TextBlock Text="Cam Studio" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- ============ Sources (left) ============ -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <!-- Built by BuildSourceList: phones, webcams, phone screens, a window on this PC. -->
                <StackPanel x:Name="SourceList" Padding="12,4,12,8" Spacing="8" />
            </ScrollViewer>
            <Grid Grid.Row="1" Padding="12,8,12,12" ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource ToolButtonStyle}" Click="AddPhone_Click" AutomationProperties.Name="Thêm điện thoại theo IP"
                        ToolTipService.ToolTip="Thêm điện thoại theo IP: khi điện thoại không tự hiện, nhập địa chỉ hiện trên app Cam Studio của điện thoại">
                    <FontIcon Glyph="{StaticResource IconAdd}" Style="{StaticResource ToolIconStyle}" />
                </Button>
                <Button Grid.Column="1" Style="{StaticResource ToolButtonStyle}" Click="Refresh_Click" AutomationProperties.Name="Tìm lại thiết bị"
                        ToolTipService.ToolTip="Tìm lại thiết bị">
                    <FontIcon Glyph="{StaticResource IconRescan}" Style="{StaticResource ToolIconStyle}" />
                </Button>
                <Button Grid.Column="2" Style="{StaticResource ToolButtonStyle}" Click="Restart_Click" AutomationProperties.Name="Khởi động lại Cam Studio"
                        ToolTipService.ToolTip="Khởi động lại Cam Studio: khi hình bị treo, giật, hoặc camera không nhận">
                    <FontIcon Glyph="{StaticResource IconRestart}" Style="{StaticResource ToolIconStyle}" />
                </Button>
                <Button Grid.Column="4" Style="{StaticResource SubtleButtonStyle}" Height="40" Padding="12,0" Click="Settings_Click"
                        AutomationProperties.Name="Cài đặt" ToolTipService.ToolTip="Cài đặt">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontFamily="{StaticResource IconFont}" Glyph="{StaticResource IconSettings}" FontSize="16" />
                        <TextBlock x:Name="SettingsLabel" Text="Cài đặt" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>

        <!-- ============ Content layer ============ -->
        <Border Grid.Row="1" Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,0,0" CornerRadius="8,0,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Padding="20,16,20,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header: the source, its mode, the virtual camera's state, the inspector. -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- The source's name; under it its mode (resolution, fps) and lens / connection. -->
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="CameraButtonText" Text="Đang tìm nguồn hình…" Style="{StaticResource SubtitleTextBlockStyle}"
                                       TextTrimming="CharacterEllipsis" MaxLines="1" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <DropDownButton x:Name="FormatButton" Padding="8,2,8,2" Margin="-8,0,0,0" Background="Transparent" BorderThickness="0"
                                                ToolTipService.ToolTip="Độ phân giải và tốc độ khung hình của nguồn">
                                    <TextBlock x:Name="FormatButtonText" Text="—" Style="{StaticResource CaptionTextBlockStyle}" />
                                    <DropDownButton.Flyout>
                                        <MenuFlyout x:Name="FormatMenu" Placement="BottomEdgeAlignedLeft" />
                                    </DropDownButton.Flyout>
                                </DropDownButton>
                                <TextBlock x:Name="SourceSubtitle" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap" MaxLines="1" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Virtual camera: live state and the picture on/off -->
                        <Border Grid.Column="1" Style="{StaticResource CardStyle}" MinHeight="0" Padding="12,6,8,6"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Ellipse x:Name="StatusDot" Width="8" Height="8" VerticalAlignment="Center"
                                         Fill="{ThemeResource TextFillColorDisabledBrush}" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Camera ảo" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock x:Name="StatusText" Text="Đang tắt" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxWidth="240" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <ToggleSwitch x:Name="VcamToggle" OnContent="" OffContent="" MinWidth="0" Margin="4,0,0,0"
                                              VerticalAlignment="Center" Toggled="VcamToggle_Toggled" AutomationProperties.Name="Phát hình qua camera ảo"
                                              ToolTipService.ToolTip="Phát / tạm dừng hình. Camera ảo &quot;Cam Studio&quot; luôn có trong các ứng dụng khi Cam Studio chạy; khi tạm dừng, ứng dụng thấy &quot;không có tín hiệu&quot;" />
                            </StackPanel>
                        </Border>

                        <ToggleButton x:Name="InspectorToggle" Grid.Column="2" IsChecked="True" VerticalAlignment="Center"
                                      Style="{StaticResource PaneToggleStyle}" Click="InspectorToggle_Click"
                                      AutomationProperties.Name="Bảng chỉnh hình" ToolTipService.ToolTip="Hiện / ẩn bảng chỉnh hình">
                            <ToggleButton.Resources>
                                <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="SubtleFillColorTransparentBrush" />
                                <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                                <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                                <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="AccentTextFillColorPrimaryBrush" />
                                <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="AccentTextFillColorPrimaryBrush" />
                                <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="AccentTextFillColorSecondaryBrush" />
                                <StaticResource x:Key="ToggleButtonBorderBrushChecked" ResourceKey="SubtleFillColorTransparentBrush" />
                                <StaticResource x:Key="ToggleButtonBorderBrushCheckedPointerOver" ResourceKey="SubtleFillColorTransparentBrush" />
                                <StaticResource x:Key="ToggleButtonBorderBrushCheckedPressed" ResourceKey="SubtleFillColorTransparentBrush" />
                            </ToggleButton.Resources>
                            <FontIcon FontFamily="{StaticResource IconFont}" Glyph="{StaticResource IconPanelRight}" FontSize="16" />
                        </ToggleButton>
                    </Grid>

                    <!-- ============ Preview ============ -->
                    <Border x:Name="PreviewHost" Grid.Row="1" Margin="0,16,0,0" CornerRadius="{StaticResource PanelCornerRadius}" Background="#FF0E0E10"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            SizeChanged="PreviewHost_SizeChanged">
                        <Grid>
                            <Image x:Name="PreviewImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   PointerPressed="Preview_PointerPressed" PointerMoved="Preview_PointerMoved"
                                   PointerReleased="Preview_PointerReleased" PointerCanceled="Preview_PointerReleased"
                                   PointerWheelChanged="Preview_PointerWheelChanged" DoubleTapped="Preview_DoubleTapped"
                                   ToolTipService.ToolTip="Cuộn chuột: thu phóng · Kéo: di chuyển khung · Nhấp đúp: đặt lại" />

                            <!-- No picture: paused, waiting, or no source yet (then how to get one). -->
                            <StackPanel x:Name="PreviewPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Spacing="16" MaxWidth="460" Padding="24">
                                <FontIcon x:Name="PlaceholderIcon" Glyph="{StaticResource IconVideoLarge}" FontFamily="{StaticResource IconFont}" FontSize="48" Foreground="#80FFFFFF" />
                                <TextBlock x:Name="PlaceholderTitle" Text="Camera ảo đang tắt" HorizontalAlignment="Center" TextAlignment="Center"
                                           TextWrapping="Wrap" Style="{StaticResource SubtitleTextBlockStyle}" Foreground="#E6FFFFFF" />
                                <TextBlock x:Name="PlaceholderHint" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                           Foreground="#B3FFFFFF" Visibility="Collapsed"
                                           Text="Mở app Cam Studio trên điện thoại (Wi‑Fi hoặc cáp USB), hoặc cắm webcam." />
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                    <Button x:Name="PlaceholderStart" Style="{StaticResource AccentButtonStyle}" Click="PlaceholderStart_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="{StaticResource IconPlay}" FontFamily="{StaticResource IconFontFilled}" FontSize="14" />
                                            <TextBlock Text="Phát hình" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="PlaceholderAdd" Content="Thêm điện thoại theo IP" Click="AddPhone_Click" Visibility="Collapsed" />
                                </StackPanel>
                            </StackPanel>

                            <Border x:Name="LiveBadge" Style="{StaticResource OverlayPillStyle}" Margin="12"
                                    HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Ellipse x:Name="LiveDot" Width="8" Height="8" Fill="{StaticResource LiveBrush}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="LiveBadgeText" Foreground="White" Style="{StaticResource CaptionTextBlockStyle}" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="ConsumerBadge" Style="{StaticResource OverlayPillStyle}" Margin="12"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed"
                                    ToolTipService.ToolTip="Ứng dụng đang dùng camera">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontFamily="{StaticResource IconFont}" Glyph="{StaticResource IconEye}" FontSize="12" Foreground="White" />
                                    <TextBlock x:Name="ConsumerBadgeText" Foreground="White" Style="{StaticResource CaptionTextBlockStyle}" />
                                </StackPanel>
                            </Border>

                            <!-- Tap-to-focus marker -->
                            <Canvas IsHitTestVisible="False">
                                <Border x:Name="FocusRing" Width="70" Height="70" BorderBrush="#FFFFD60A" BorderThickness="1.5"
                                        CornerRadius="6" Opacity="0" />
                            </Canvas>

                            <InfoBar x:Name="ErrorBar" Severity="Error" IsClosable="True" Title="Không bật được camera"
                                     VerticalAlignment="Top" HorizontalAlignment="Center" Margin="12,52,12,12" />
                            <InfoBar x:Name="UpdateBar" Severity="Informational" IsClosable="True"
                                     VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="12">
                                <InfoBar.ActionButton>
                                    <Button Content="Cập nhật ngay" Click="UpdateNow_Click" />
                                </InfoBar.ActionButton>
                            </InfoBar>
                        </Grid>
                    </Border>

                    <!-- ============ Camera bar (a phone): lenses, front / back, flash, exposure ============ -->
                    <Border x:Name="CameraBar" Grid.Row="2" Style="{StaticResource CameraBarStyle}" Margin="0,12,0,0" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <!-- One chip per lens on this side (0.6× 1× 2× Macro), built in UpdateCameraOverlay. -->
                            <StackPanel x:Name="LensChips" Orientation="Horizontal" Spacing="2" />
                            <Border x:Name="BarDivider" Style="{StaticResource BarDividerStyle}" />
                            <Button x:Name="FacingButton" Style="{StaticResource BarIconButtonStyle}" Click="FacingButton_Click"
                                    AutomationProperties.Name="Đổi camera trước / sau" ToolTipService.ToolTip="Đổi camera trước / sau">
                                <FontIcon FontFamily="{StaticResource IconFont}" Glyph="{StaticResource IconCameraSwitch}" FontSize="16" />
                            </Button>
                            <ToggleButton x:Name="FlashButton" Style="{StaticResource BarIconToggleStyle}" Click="FlashButton_Click"
                                          AutomationProperties.Name="Đèn flash" ToolTipService.ToolTip="Đèn flash">
                                <FontIcon x:Name="FlashIcon" FontFamily="{StaticResource IconFont}" Glyph="{StaticResource IconFlash}" FontSize="16" />
                            </ToggleButton>
                            <Button x:Name="ExposureButton" Style="{StaticResource BarIconButtonStyle}" AutomationProperties.Name="Bù sáng" ToolTipService.ToolTip="Bù sáng">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontFamily="{StaticResource IconFont}" Glyph="{StaticResource IconExposure}" FontSize="16" />
                                    <TextBlock x:Name="BiasText" Text="0 EV" VerticalAlignment="Center" />
                                </StackPanel>
                                <Button.Flyout>
                                    <Flyout Placement="Top">
                                        <StackPanel Width="260" Spacing="8">
                                            <TextBlock Text="Bù sáng" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <Slider x:Name="BiasSlider" Minimum="-2" Maximum="2" StepFrequency="0.1"
                                                    ValueChanged="BiasSlider_ValueChanged" IsThumbToolTipEnabled="False" />
                                            <TextBlock Style="{StaticResource InspectorHintStyle}" Margin="0"
                                                       Text="Bấm vào một điểm trên hình để lấy nét và đo sáng ở đó." />
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ============ Inspector (right) ============ -->
                <!-- One scrolling page of sections (Expander), no tabs: the frame, colour, the
                     phone's manual controls, details. A section a source has nothing for is hidden
                     (UpdateOverlayVisibility). Explanations sit behind (i) buttons. -->
                <Grid x:Name="InspectorPane" Grid.Column="1" Width="340"
                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,16,16,20">
                        <StackPanel Spacing="8">

                            <!-- Khung hình: automatic framing, zoom, rotation, aspect -->
                            <Expander x:Name="FrameSection" Style="{StaticResource SectionExpanderStyle}" IsExpanded="True">
                                <Expander.Header>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <FontIcon Glyph="{StaticResource IconCrop}" Style="{StaticResource SectionIconStyle}" />
                                            <TextBlock Text="Khung hình" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </Expander.Header>
                                <StackPanel>
                                    <!-- Only while a source runs: framing and zoom need a picture. -->
                                    <StackPanel x:Name="ZoomGroup">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" Spacing="2">
                                                <TextBlock Text="Tự căn khung" Style="{StaticResource BodyTextBlockStyle}" VerticalAlignment="Center" />
                                                <Button Style="{StaticResource InfoButtonStyle}" AutomationProperties.Name="Giải thích: Tự căn khung" ToolTipService.ToolTip="Theo khuôn mặt: tự zoom và giữ người ở giữa khung. Cho webcam và camera điện thoại, không cho màn hình hay cửa sổ.">
                                                    <FontIcon FontFamily="{StaticResource IconFont}" Glyph="{StaticResource IconInfo}" FontSize="14" />
                                                    <Button.Flyout><Flyout><TextBlock Style="{StaticResource InfoTextStyle}" Text="Theo khuôn mặt: tự zoom và giữ người ở giữa khung. Cho webcam và camera điện thoại, không cho màn hình hay cửa sổ." /></Flyout></Button.Flyout>
                                                </Button>
                                            </StackPanel>
                                            <ToggleSwitch x:Name="AutoFrameToggle" HorizontalAlignment="Right" OnContent="" OffContent="" MinWidth="0"
                                                          Toggled="AutoFrameToggle_Toggled" />
                                        </Grid>
                                        <TextBlock x:Name="AutoFrameHint" Style="{StaticResource InspectorHintStyle}" Margin="0,0,0,2" />

                                        <Grid Margin="0,16,0,8">
                                            <StackPanel Orientation="Horizontal" Spacing="2">
                                                <TextBlock Text="Thu phóng" Style="{StaticResource InspectorSubheadStyle}" Margin="0" VerticalAlignment="Center" />
                                                <Button Style="{StaticResource InfoButtonStyle}" AutomationProperties.Name="Giải thích: Thu phóng">
                                                    <FontIcon FontFamily="{StaticResource IconFont}" Glyph="{StaticResource IconInfo}" FontSize="14" />
                                                    <Button.Flyout><Flyout><TextBlock x:Name="ZoomHint" Style="{StaticResource InfoTextStyle}" Text="Thu phóng trên máy tính. Kéo trên hình để chọn khung, nhấp đúp để đặt lại." /></Flyout></Button.Flyout>
                                                </Button>
                                            </StackPanel>
                                            <TextBlock x:Name="ZoomValueText" Text="1.0×" Style="{StaticResource SliderValueStyle}"
                                                       FontWeight="SemiBold" />
                                        </Grid>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Button Click="ZoomOut_Click" Style="{StaticResource SubtleButtonStyle}" Padding="8" AutomationProperties.Name="Thu nhỏ" ToolTipService.ToolTip="Thu nhỏ">
                                                <FontIcon FontFamily="{StaticResource IconFont}" Glyph="{StaticResource IconZoomOut}" FontSize="16" />
                                            </Button>
                                            <Slider x:Name="ZoomSlider" Grid.Column="1" Minimum="1" Maximum="4" StepFrequency="0.05" VerticalAlignment="Center"
                                                    ValueChanged="ZoomSlider_ValueChanged" IsThumbToolTipEnabled="False" />
                                            <Button Grid.Column="2" Click="ZoomIn_Click" Style="{StaticResource SubtleButtonStyle}" Padding="8" AutomationProperties.Name="Phóng to" ToolTipService.ToolTip="Phóng to">
                                                <FontIcon FontFamily="{StaticResource IconFont}" Glyph="{StaticResource IconZoomIn}" FontSize="16" />
                                            </Button>
                                        </Grid>
                                    </StackPanel>

                                    <TextBlock Text="Xoay và lật" Style="{StaticResource InspectorSubheadStyle}" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ToggleButton x:Name="MirrorButton" Style="{StaticResource SegmentToggleStyle}" Click="Mirror_Click"
                                                      ToolTipService.ToolTip="Lật ngang như gương">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon FontFamily="{StaticResource IconFont}" Glyph="{StaticResource IconFlipHorizontal}" FontSize="14" />
                                                <TextBlock Text="Gương" />
                                            </StackPanel>
                                        </ToggleButton>
                                        <ToggleButton x:Name="FlipButton" Grid.Column="1" Style="{StaticResource SegmentToggleStyle}" Click="Flip_Click"
                                                      ToolTipService.ToolTip="Lật dọc">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon FontFamily="{StaticResource IconFont}" Glyph="{StaticResource IconFlipVertical}" FontSize="14" />
                                                <TextBlock Text="Lật dọc" />
                                            </StackPanel>
                                        </ToggleButton>
                                        <Button x:Name="RotateButton" Grid.Column="2" Style="{StaticResource SegmentButtonStyle}" Click="Rotate_Click"
                                                ToolTipService.ToolTip="Xoay 90° theo chiều kim đồng hồ">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon FontFamily="{StaticResource IconFont}" Glyph="{StaticResource IconRotate}" FontSize="14" />
                                                <TextBlock x:Name="RotateText" Text="0°" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Spacing="2" Margin="0,16,0,8">
                                        <TextBlock Text="Tỉ lệ khung" Style="{StaticResource InspectorSubheadStyle}" Margin="0" VerticalAlignment="Center" />
                                        <Button Style="{StaticResource InfoButtonStyle}" AutomationProperties.Name="Giải thích: Tỉ lệ khung" ToolTipService.ToolTip="Cắt ở giữa khung, không làm méo hình.">
                                            <FontIcon FontFamily="{StaticResource IconFont}" Glyph="{StaticResource IconInfo}" FontSize="14" />
                                            <Button.Flyout><Flyout><TextBlock Style="{StaticResource InfoTextStyle}" Text="Cắt ở giữa khung, không làm méo hình." /></Flyout></Button.Flyout>
                                        </Button>
                                    </StackPanel>
                                    <!-- One choice of five, as a segmented row (Tag = AppSettings.Aspect). -->
                                    <Grid x:Name="AspectChips" ColumnSpacing="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ToggleButton Tag="0" Content="Gốc" Style="{StaticResource SegmentToggleStyle}" Padding="0" Click="AspectChip_Click"
                                                      ToolTipService.ToolTip="Giữ nguyên khung của nguồn" />
                                        <ToggleButton Tag="1" Grid.Column="1" Content="16:9" Style="{StaticResource SegmentToggleStyle}" Padding="0" Click="AspectChip_Click" />
                                        <ToggleButton Tag="2" Grid.Column="2" Content="4:3" Style="{StaticResource SegmentToggleStyle}" Padding="0" Click="AspectChip_Click" />
                                        <ToggleButton Tag="3" Grid.Column="3" Content="1:1" Style="{StaticResource SegmentToggleStyle}" Padding="0" Click="AspectChip_Click" />
                                        <ToggleButton Tag="4" Grid.Column="4" Content="9:16" Style="{StaticResource SegmentToggleStyle}" Padding="0" Click="AspectChip_Click"
                                                      ToolTipService.ToolTip="Dọc, như điện thoại" />
                                    </Grid>
                                </StackPanel>
                            </Expander>

                            <!-- Màu sắc: presets, then the four sliders, each track showing what it does -->
                            <Expander x:Name="ColorSection" Style="{StaticResource SectionExpanderStyle}" IsExpanded="True">
                                <Expander.Header>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <FontIcon Glyph="{StaticResource IconColor}" Style="{StaticResource SectionIconStyle}" />
                                            <TextBlock Text="Màu sắc" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock x:Name="ColorSummary" Grid.Column="1" Style="{StaticResource SectionSummaryStyle}" />
                                    </Grid>
                                </Expander.Header>
                                <StackPanel>
                                    <Grid x:Name="PresetGrid" ColumnSpacing="8" RowSpacing="8" Margin="0,4,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <ToggleButton Tag="0,0,0,0" Style="{StaticResource PresetChipStyle}" Click="Preset_Click" ToolTipService.ToolTip="Tự nhiên">
                                            <StackPanel>
                                                <Ellipse Style="{StaticResource SwatchStyle}">
                                                    <Ellipse.Fill>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#FFC9D3DD" Offset="0" />
                                                            <GradientStop Color="#FF6F8091" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                                <TextBlock Text="Tự nhiên" Style="{StaticResource PresetLabelStyle}" />
                                            </StackPanel>
                                        </ToggleButton>
                                        <ToggleButton Grid.Column="1" Tag="18,6,6,0" Style="{StaticResource PresetChipStyle}" Click="Preset_Click" ToolTipService.ToolTip="Sáng">
                                            <StackPanel>
                                                <Ellipse Style="{StaticResource SwatchStyle}">
                                                    <Ellipse.Fill>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#FFFFF7DE" Offset="0" />
                                                            <GradientStop Color="#FFFFCF6B" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                                <TextBlock Text="Sáng" Style="{StaticResource PresetLabelStyle}" />
                                            </StackPanel>
                                        </ToggleButton>
                                        <ToggleButton Grid.Column="2" Tag="4,4,8,40" Style="{StaticResource PresetChipStyle}" Click="Preset_Click" ToolTipService.ToolTip="Ấm">
                                            <StackPanel>
                                                <Ellipse Style="{StaticResource SwatchStyle}">
                                                    <Ellipse.Fill>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#FFFFCA85" Offset="0" />
                                                            <GradientStop Color="#FFE8692E" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                                <TextBlock Text="Ấm" Style="{StaticResource PresetLabelStyle}" />
                                            </StackPanel>
                                        </ToggleButton>
                                        <ToggleButton Grid.Column="3" Tag="0,4,0,-35" Style="{StaticResource PresetChipStyle}" Click="Preset_Click" ToolTipService.ToolTip="Lạnh">
                                            <StackPanel>
                                                <Ellipse Style="{StaticResource SwatchStyle}">
                                                    <Ellipse.Fill>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#FFB3DAFF" Offset="0" />
                                                            <GradientStop Color="#FF2F6FEB" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                                <TextBlock Text="Lạnh" Style="{StaticResource PresetLabelStyle}" />
                                            </StackPanel>
                                        </ToggleButton>
                                        <ToggleButton Grid.Row="1" Tag="2,14,40,4" Style="{StaticResource PresetChipStyle}" Click="Preset_Click" ToolTipService.ToolTip="Rực rỡ">
                                            <StackPanel>
                                                <Ellipse Style="{StaticResource SwatchStyle}">
                                                    <Ellipse.Fill>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#FFFF5FA2" Offset="0" />
                                                            <GradientStop Color="#FF7B5CFF" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                                <TextBlock Text="Rực rỡ" Style="{StaticResource PresetLabelStyle}" />
                                            </StackPanel>
                                        </ToggleButton>
                                        <ToggleButton Grid.Row="1" Grid.Column="1" Tag="8,-14,-12,8" Style="{StaticResource PresetChipStyle}" Click="Preset_Click" ToolTipService.ToolTip="Dịu">
                                            <StackPanel>
                                                <Ellipse Style="{StaticResource SwatchStyle}">
                                                    <Ellipse.Fill>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#FFF3E6DC" Offset="0" />
                                                            <GradientStop Color="#FFC4AC9E" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                                <TextBlock Text="Dịu" Style="{StaticResource PresetLabelStyle}" />
                                            </StackPanel>
                                        </ToggleButton>
                                        <ToggleButton Grid.Row="1" Grid.Column="2" Tag="-6,22,-18,12" Style="{StaticResource PresetChipStyle}" Click="Preset_Click" ToolTipService.ToolTip="Điện ảnh">
                                            <StackPanel>
                                                <Ellipse Style="{StaticResource SwatchStyle}">
                                                    <Ellipse.Fill>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#FF1F7F86" Offset="0" />
                                                            <GradientStop Color="#FFF09A4A" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                                <TextBlock Text="Điện ảnh" Style="{StaticResource PresetLabelStyle}" />
                                            </StackPanel>
                                        </ToggleButton>
                                        <ToggleButton Grid.Row="1" Grid.Column="3" Tag="0,12,-100,0" Style="{StaticResource PresetChipStyle}" Click="Preset_Click" ToolTipService.ToolTip="Đen trắng">
                                            <StackPanel>
                                                <Ellipse Style="{StaticResource SwatchStyle}">
                                                    <Ellipse.Fill>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#FFFFFFFF" Offset="0" />
                                                            <GradientStop Color="#FF1A1A1A" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                                <TextBlock Text="Đen trắng" Style="{StaticResource PresetLabelStyle}" />
                                            </StackPanel>
                                        </ToggleButton>
                                    </Grid>
                                    <Grid Margin="0,12,0,0">
                                        <TextBlock Text="Độ sáng" VerticalAlignment="Center" />
                                        <TextBlock x:Name="BrightnessValue" Text="0" Style="{StaticResource SliderValueStyle}" />
                                    </Grid>
                                    <Slider x:Name="BrightnessSlider" Minimum="-100" Maximum="100" StepFrequency="1" IsThumbToolTipEnabled="False"
                                            ValueChanged="AdjustSlider_ValueChanged">
                                        <Slider.Resources>
                                            <StaticResource x:Key="SliderTrackFill" ResourceKey="BrightnessTrackBrush" />
                                            <StaticResource x:Key="SliderTrackFillPointerOver" ResourceKey="BrightnessTrackBrush" />
                                            <StaticResource x:Key="SliderTrackFillPressed" ResourceKey="BrightnessTrackBrush" />
                                            <SolidColorBrush x:Key="SliderTrackValueFill" Color="Transparent" />
                                            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="Transparent" />
                                            <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="Transparent" />
                                            <x:Double x:Key="SliderTrackThemeHeight">6</x:Double>
                                        </Slider.Resources>
                                    </Slider>
                                    <Grid Margin="0,12,0,0">
                                        <TextBlock Text="Tương phản" VerticalAlignment="Center" />
                                        <TextBlock x:Name="ContrastValue" Text="0" Style="{StaticResource SliderValueStyle}" />
                                    </Grid>
                                    <Slider x:Name="ContrastSlider" Minimum="-100" Maximum="100" StepFrequency="1" IsThumbToolTipEnabled="False"
                                            ValueChanged="AdjustSlider_ValueChanged">
                                        <Slider.Resources>
                                            <StaticResource x:Key="SliderTrackFill" ResourceKey="ContrastTrackBrush" />
                                            <StaticResource x:Key="SliderTrackFillPointerOver" ResourceKey="ContrastTrackBrush" />
                                            <StaticResource x:Key="SliderTrackFillPressed" ResourceKey="ContrastTrackBrush" />
                                            <SolidColorBrush x:Key="SliderTrackValueFill" Color="Transparent" />
                                            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="Transparent" />
                                            <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="Transparent" />
                                            <x:Double x:Key="SliderTrackThemeHeight">6</x:Double>
                                        </Slider.Resources>
                                    </Slider>
                                    <Grid Margin="0,12,0,0">
                                        <TextBlock Text="Độ bão hòa" VerticalAlignment="Center" />
                                        <TextBlock x:Name="SaturationValue" Text="0" Style="{StaticResource SliderValueStyle}" />
                                    </Grid>
                                    <Slider x:Name="SaturationSlider" Minimum="-100" Maximum="100" StepFrequency="1" IsThumbToolTipEnabled="False"
                                            ValueChanged="AdjustSlider_ValueChanged">
                                        <Slider.Resources>
                                            <StaticResource x:Key="SliderTrackFill" ResourceKey="SaturationTrackBrush" />
                                            <StaticResource x:Key="SliderTrackFillPointerOver" ResourceKey="SaturationTrackBrush" />
                                            <StaticResource x:Key="SliderTrackFillPressed" ResourceKey="SaturationTrackBrush" />
                                            <SolidColorBrush x:Key="SliderTrackValueFill" Color="Transparent" />
                                            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="Transparent" />
                                            <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="Transparent" />
                                            <x:Double x:Key="SliderTrackThemeHeight">6</x:Double>
                                        </Slider.Resources>
                                    </Slider>
                                    <Grid Margin="0,12,0,0">
                                        <TextBlock Text="Nhiệt độ màu" VerticalAlignment="Center" />
                                        <TextBlock x:Name="TemperatureValue" Text="0" Style="{StaticResource SliderValueStyle}" />
                                    </Grid>
                                    <Slider x:Name="TemperatureSlider" Minimum="-100" Maximum="100" StepFrequency="1" IsThumbToolTipEnabled="False"
                                            ValueChanged="AdjustSlider_ValueChanged">
                                        <Slider.Resources>
                                            <StaticResource x:Key="SliderTrackFill" ResourceKey="TemperatureTrackBrush" />
                                            <StaticResource x:Key="SliderTrackFillPointerOver" ResourceKey="TemperatureTrackBrush" />
                                            <StaticResource x:Key="SliderTrackFillPressed" ResourceKey="TemperatureTrackBrush" />
                                            <SolidColorBrush x:Key="SliderTrackValueFill" Color="Transparent" />
                                            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="Transparent" />
                                            <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="Transparent" />
                                            <x:Double x:Key="SliderTrackThemeHeight">6</x:Double>
                                        </Slider.Resources>
                                    </Slider>
                                    <HyperlinkButton Content="Đặt lại" HorizontalAlignment="Right" Padding="8,4" Margin="0,8,0,0" Click="AdjustReset_Click" />
                                </StackPanel>
                            </Expander>

                            <!-- Chỉnh tay: the phone's focus, exposure, white balance, stabilization -->
                            <Expander x:Name="ManualSection" Style="{StaticResource SectionExpanderStyle}"
                                      Expanding="Section_Expanding" Collapsed="Section_Collapsed">
                                <Expander.Header>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <FontIcon Glyph="{StaticResource IconOptions}" Style="{StaticResource SectionIconStyle}" />
                                            <TextBlock Text="Chỉnh tay" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </Expander.Header>
                                <!-- Built by BuildPhoneControls from what this lens supports. -->
                                <StackPanel x:Name="PhoneControls" Spacing="6" />
                            </Expander>

                            <!-- Chi tiết -->
                            <Expander x:Name="DetailsSection" Style="{StaticResource SectionExpanderStyle}"
                                      Expanding="Section_Expanding" Collapsed="Section_Collapsed">
                                <Expander.Header>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <FontIcon Glyph="{StaticResource IconInfo}" Style="{StaticResource SectionIconStyle}" />
                                            <TextBlock Text="Chi tiết" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock x:Name="DetailsSummary" Grid.Column="1" Style="{StaticResource SectionSummaryStyle}" />
                                    </Grid>
                                </Expander.Header>
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Nguồn" Style="{StaticResource InfoLabelStyle}" />
                                        <TextBlock x:Name="InfoCamera" Grid.Column="1" Text="—" Style="{StaticResource InfoValueStyle}" />
                                        <TextBlock Grid.Row="1" Text="Camera ảo" Style="{StaticResource InfoLabelStyle}" />
                                        <TextBlock x:Name="InfoOutput" Grid.Row="1" Grid.Column="1" Text="—" Style="{StaticResource InfoValueStyle}" />
                                        <TextBlock Grid.Row="2" Text="Tốc độ thực tế" Style="{StaticResource InfoLabelStyle}" />
                                        <TextBlock x:Name="InfoFps" Grid.Row="2" Grid.Column="1" Text="—" Style="{StaticResource InfoValueStyle}" />
                                        <TextBlock Grid.Row="3" Text="Khung bị rơi" Style="{StaticResource InfoLabelStyle}" />
                                        <TextBlock x:Name="InfoDropped" Grid.Row="3" Grid.Column="1" Text="—" Style="{StaticResource InfoValueStyle}" />
                                        <TextBlock Grid.Row="4" Text="Xử lý mỗi khung" Style="{StaticResource InfoLabelStyle}" />
                                        <TextBlock x:Name="InfoProcess" Grid.Row="4" Grid.Column="1" Text="—" Style="{StaticResource InfoValueStyle}" />
                                        <TextBlock Grid.Row="5" Text="Đang dùng camera" Style="{StaticResource InfoLabelStyle}" />
                                        <TextBlock x:Name="InfoConsumers" Grid.Row="5" Grid.Column="1" Text="—" Style="{StaticResource InfoValueStyle}" />
                                        <TextBlock Grid.Row="6" Text="Cam Studio dùng" Style="{StaticResource InfoLabelStyle}" />
                                        <TextBlock x:Name="InfoCpu" Grid.Row="6" Grid.Column="1" Text="—" Style="{StaticResource InfoValueStyle}" />
                                    </Grid>
                                    <StackPanel x:Name="PhoneInfoSection" Visibility="Collapsed">
                                        <TextBlock Text="Điện thoại" Style="{StaticResource InspectorSubheadStyle}" />
                                        <TextBlock x:Name="PhoneInfoText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    </StackPanel>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>

        <!-- ============ Settings ============ -->
        <ContentDialog x:Name="SettingsDialog" Title="Cài đặt" CloseButtonText="Đóng" DefaultButton="Close">
            <ScrollViewer MaxHeight="560" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
                <StackPanel Width="420" Spacing="12">
                    <TextBlock Text="Chung" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ComboBox x:Name="ThemeCombo" Header="Giao diện" HorizontalAlignment="Stretch"
                              SelectionChanged="ThemeCombo_SelectionChanged">
                        <x:String>Theo Windows</x:String>
                        <x:String>Sáng</x:String>
                        <x:String>Tối</x:String>
                    </ComboBox>
                    <ToggleSwitch x:Name="AutostartToggle" Header="Khởi động cùng Windows"
                                  OnContent="Bật (chạy ẩn ở khay)" OffContent="Tắt" Toggled="AutostartToggle_Toggled" />
                    <ToggleSwitch x:Name="CloseToTrayToggle" Header="Khi đóng cửa sổ"
                                  OnContent="Chạy tiếp ở khay" OffContent="Thoát hẳn" Toggled="CloseToTrayToggle_Toggled" />

                    <StackPanel Orientation="Horizontal" Spacing="2" Margin="0,16,0,0">
                        <TextBlock Text="Camera ảo" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                        <Button Style="{StaticResource InfoButtonStyle}" AutomationProperties.Name="Giải thích: Kích thước camera ảo" ToolTipService.ToolTip="Tự động: theo cỡ gốc của nguồn. Khi đang có ứng dụng dùng camera, đổi nguồn sẽ giữ nguyên cỡ và thêm viền đen; gọi xong tự về cỡ gốc. Chọn 1080p nếu muốn khung luôn ngang.">
                            <FontIcon FontFamily="{StaticResource IconFont}" Glyph="{StaticResource IconInfo}" FontSize="14" />
                            <Button.Flyout><Flyout><TextBlock Style="{StaticResource InfoTextStyle}" Text="Tự động: theo cỡ gốc của nguồn. Khi đang có ứng dụng dùng camera, đổi nguồn sẽ giữ nguyên cỡ và thêm viền đen; gọi xong tự về cỡ gốc. Chọn 1080p nếu muốn khung luôn ngang." /></Flyout></Button.Flyout>
                        </Button>
                    </StackPanel>
                    <ComboBox x:Name="OutputSizeCombo" Header="Kích thước" HorizontalAlignment="Stretch"
                              SelectionChanged="OutputSizeCombo_SelectionChanged">
                        <x:String>Tự động (nét nhất)</x:String>
                        <x:String>4K · 3840 × 2160</x:String>
                        <x:String>1080p · 1920 × 1080</x:String>
                        <x:String>720p · 1280 × 720</x:String>
                    </ComboBox>

                    <TextBlock Text="Cập nhật" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,0" />
                    <ToggleSwitch x:Name="AutoUpdateToggle" Header="Tự động cập nhật"
                                  OnContent="Bật (tải sẵn, cài khi không dùng camera)" OffContent="Tắt (chỉ báo có bản mới)"
                                  Toggled="AutoUpdateToggle_Toggled" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="UpdateButton" Content="Kiểm tra cập nhật" Click="UpdateButton_Click" />
                        <TextBlock x:Name="UpdateStatusText" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                   VerticalAlignment="Center" MaxWidth="260" />
                    </StackPanel>
                    <TextBlock x:Name="VersionText" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </ScrollViewer>
        </ContentDialog>
    </Grid>
</Window>
