<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />
    <!-- The phone's sound for the PC, only when the PC asks (docs/protocol.md 5.5). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Home Wi‑Fi: TCP server for the PC and mDNS (_camstudio._tcp) advertising. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- The camera in the background: a foreground service of type camera (CameraService).
         Screen sharing: one of type mediaProjection (docs/protocol.md 1.1). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- While the camera streams with the screen off: CPU awake, Wi‑Fi out of power saving. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Updates from the GitHub releases (AppUpdater, docs/updates.md). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-feature android:name="android.hardware.camera.any" android:required="true" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:label="Cam Studio"
        android:icon="@drawable/ic_launcher"
        android:allowBackup="false"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <!-- Showing it starts CameraService, which serves the PC (in the background too). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="unspecified"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".CameraService"
            android:exported="false"
            android:foregroundServiceType="camera|microphone" />

        <service
            android:name=".ScreenService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <receiver
            android:name=".AppUpdater$StatusReceiver"
            android:exported="false" />
    </application>
</manifest>
